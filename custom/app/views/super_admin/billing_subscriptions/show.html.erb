<% subscription = page.resource %>
<% content_for(:title) { "Subscription ##{subscription.id}" } %>
<%# channel_type -> human label, from the one list of channel types this fork has (Channels::Capability) %>
<% channel_labels = BillingPlanChannelsField.channel_options.to_h { |label, value| [value, label] } %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title">
    Subscription #<%= subscription.id %> — <%= subscription.account&.name %>
  </h1>
  <div>
    <%= link_to 'All subscriptions', super_admin_billing_subscriptions_path, class: 'button' %>
  </div>
</header>

<section class="main-content__body">
  <dl>
    <dt class="attribute-label">Account</dt>
    <dd class="attribute-data">
      <% if subscription.account %>
        <%= link_to "##{subscription.account.id} #{subscription.account.name}", super_admin_account_path(subscription.account) %>
      <% else %>—<% end %>
    </dd>

    <dt class="attribute-label">Plan</dt>
    <dd class="attribute-data"><%= subscription.plan&.name || '—' %></dd>

    <dt class="attribute-label">Channels sold by the plan</dt>
    <dd class="attribute-data">
      <% if subscription.plan&.sells_channels? %>
        <%= subscription.plan.channel_entitlements.map { |type| channel_labels[type] || type }.join(', ') %>
      <% else %>
        All channels (no restriction)
      <% end %>
    </dd>

    <dt class="attribute-label">Usage / enforced limit</dt>
    <dd class="attribute-data">
      <%= Billing::ApiSerializer.usage(subscription.account).map { |key, usage|
            "#{BillingPlanLimitsField::LABELS.fetch(key.to_s)}: #{usage[:used]} / #{usage[:limit] || '∞'}" }.join(' · ') %>
    </dd>

    <dt class="attribute-label">Status</dt>
    <dd class="attribute-data">
      <strong><%= subscription.status %></strong>
      <%= subscription.usable? ? '(account usable)' : '(account locked)' %>
    </dd>

    <dt class="attribute-label">Source</dt>
    <dd class="attribute-data"><%= subscription.source %></dd>

    <dt class="attribute-label">Trial ends</dt>
    <dd class="attribute-data"><%= subscription.trial_ends_at&.strftime('%d %b %Y %H:%M') || '—' %></dd>

    <dt class="attribute-label">Period ends</dt>
    <dd class="attribute-data">
      <%= subscription.current_period_end&.strftime('%d %b %Y %H:%M') || '—' %>
      <%= '(cancels at period end)' if subscription.cancel_at_period_end %>
    </dd>

    <dt class="attribute-label">Grace period ends</dt>
    <dd class="attribute-data"><%= subscription.grace_period_ends_at&.strftime('%d %b %Y %H:%M') || '—' %></dd>

    <dt class="attribute-label">Stripe customer</dt>
    <dd class="attribute-data"><%= subscription.stripe_customer_id || '—' %></dd>

    <dt class="attribute-label">Stripe subscription</dt>
    <dd class="attribute-data"><%= subscription.stripe_subscription_id || '—' %></dd>
  </dl>

  <h2 style="font-weight: 600; margin: 32px 0 8px;">Actions</h2>

  <% if stripe_paid?(subscription) %>
    <p style="font-size: 13px; color: #b45309; margin-bottom: 16px;">
      This account pays through Stripe. To extend a trial or grant a plan manually, cancel the Stripe subscription first.
    </p>
  <% else %>
    <div style="margin-bottom: 24px;">
      <h3 style="font-weight: 600; margin-bottom: 8px;">Extend trial</h3>
      <%= form_with url: extend_trial_super_admin_billing_subscription_path(subscription), method: :post, local: true do |f| %>
        <%= f.number_field :days, value: 7, min: 1, style: 'width: 120px; display: inline-block;' %>
        <span>days</span>
        <%= f.submit 'Extend trial', style: 'margin-left: 8px;' %>
      <% end %>
    </div>

    <div style="margin-bottom: 24px;">
      <h3 style="font-weight: 600; margin-bottom: 8px;">Activate / grant a plan manually (no payment)</h3>
      <%= form_with url: grant_plan_super_admin_billing_subscription_path(subscription), method: :post, local: true do |f| %>
        <%= f.select :plan_id,
                     options_from_collection_for_select(BillingPlan.ordered, :id, :name, subscription.plan_id),
                     {}, style: 'width: 200px; display: inline-block;' %>
        <span style="margin: 0 8px;">until</span>
        <%= f.date_field :ends_at, style: 'width: 180px; display: inline-block;' %>
        <span style="font-size: 12px; opacity: .7;">(empty = no end date)</span>
        <%= f.submit 'Grant plan', style: 'margin-left: 8px;' %>
      <% end %>
    </div>
  <% end %>

  <% unless subscription.status.in?(%w[canceled inactive]) %>
    <div style="margin-bottom: 24px;">
      <h3 style="font-weight: 600; margin-bottom: 8px;">Cancel subscription</h3>
      <p style="font-size: 13px; opacity: .8; margin-bottom: 8px;">
        Stops the subscription immediately<%= ' and cancels it on Stripe' if stripe_paid?(subscription) %>. The account will be locked.
      </p>
      <%= button_to 'Cancel subscription now',
                    cancel_subscription_super_admin_billing_subscription_path(subscription),
                    method: :post,
                    form: { onsubmit: "return confirm('Cancel this subscription now? The account will be locked.');" },
                    style: 'background: #dc2626; color: #fff;' %>
    </div>
  <% end %>

  <h2 style="font-weight: 600; margin: 32px 0 8px;">Entitlement overrides</h2>
  <p style="font-size: 13px; opacity: .8; margin-bottom: 8px;">
    An explicit exception for this account only. It wins over the plan and survives a plan sync, and every
    grant and removal is written to the account's audit log.
  </p>

  <%# Every row, not Billing::Entitlements.overrides: that answers "what applies right now" and hides what has
      lapsed, and an operator needs to see a lapsed exception to understand why a customer lost a capability. %>
  <% overrides = subscription.account ? subscription.account.billing_entitlement_overrides.order(:kind, :name) : [] %>
  <% if overrides.empty? %>
    <p style="font-size: 13px; opacity: .7; margin-bottom: 16px;">
      None. This account gets exactly what its plan entitles it to.
    </p>
  <% else %>
    <table style="width: 100%; margin-bottom: 16px; font-size: 13px;">
      <thead>
        <tr>
          <th style="text-align: start;">Kind</th>
          <th style="text-align: start;">Capability</th>
          <th style="text-align: start;">Effect</th>
          <th style="text-align: start;">Reason</th>
          <th style="text-align: start;">Granted by</th>
          <th style="text-align: start;">Expires</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% overrides.each do |override| %>
          <tr>
            <td><%= override.kind %></td>
            <td><%= override.kind_channel? ? (channel_labels[override.name] || override.name) : override.name %></td>
            <td>
              <% if override.kind_limit? %>
                <%= override.limit_value %>
              <% else %>
                <%= override.enabled ? 'Allowed' : 'Denied' %>
              <% end %>
            </td>
            <td><%= override.reason %></td>
            <td><%= override.granted_by&.email || '—' %></td>
            <td>
              <% if override.expires_at.nil? %>
                —
              <% else %>
                <%= override.expires_at.strftime('%d %b %Y') %><%= ' (lapsed)' if override.lapsed? %>
              <% end %>
            </td>
            <td>
              <%= button_to 'Revoke',
                            revoke_override_super_admin_billing_subscription_path(subscription),
                            method: :post,
                            params: { override_id: override.id },
                            form: { onsubmit: "return confirm('Remove this override? The account falls back to its plan.');" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <% if subscription.account %>
    <%= render 'override_form', subscription: subscription, kind: 'feature',
                                title: 'Feature override',
                                hint: 'Switch one capability on or off for this account regardless of its plan.',
                                options: BillingPlan.assignable_features
                                                    .map { |f| [f['display_name'].presence || f['name'], f['name']] }.sort %>

    <%= render 'override_form', subscription: subscription, kind: 'limit',
                                title: 'Limit override',
                                hint: 'A different ceiling for one counted resource, enforced by the same check as the plan limit.',
                                options: BillingPlan::LIMIT_KEYS.map { |key| [BillingPlanLimitsField::LABELS.fetch(key), key] } %>

    <%= render 'override_form', subscription: subscription, kind: 'channel',
                                title: 'Channel override',
                                hint: 'Sell or withhold one channel type for this account regardless of its plan.',
                                options: BillingPlanChannelsField.channel_options %>
  <% end %>
</section>
