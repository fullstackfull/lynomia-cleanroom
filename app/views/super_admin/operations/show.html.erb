<% content_for(:title) do %>Operations<% end %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title">Operations</h1>
</header>

<section class="main-content__body">
  <%= render 'tabs' %>

  <p class="text-sm text-slate-600 mb-6">
    What in Lynomia Chat needs operator attention. Every row says how it was established, and an area with no
    source at all reads <strong>unknown</strong> rather than green &mdash; "nothing was reported" and "we
    checked and it is fine" are different statements.
  </p>

  <div class="grid grid-cols-1 md:grid-cols-5 gap-3 mb-8">
    <% @overview[:totals].each do |label, value| %>
      <div class="border border-slate-100 rounded-md p-3">
        <p class="text-xs text-slate-500"><%= label.to_s.humanize %></p>
        <p class="text-xl text-slate-800"><%= number_with_delimiter(value) %></p>
      </div>
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <div>
      <h2 class="text-base font-semibold mb-1">Platform</h2>
      <p class="text-xs text-slate-500 mb-2">Read live, this request.</p>
      <div class="border border-slate-100 rounded-md px-4">
        <% @overview[:probes].sort_by(&:rank).each do |component| %>
          <%= render 'component', component: component %>
        <% end %>
      </div>
      <p class="text-xs text-slate-500 mt-2 font-mono break-all">
        <%= @overview[:release].map { |key, value| "#{key}=#{Array(value).join(',')}" }.join(' ') %>
      </p>
      <p class="mt-2">
        <%= link_to 'Sidekiq dashboard', sidekiq_web_url, class: 'text-xs text-woot-500 hover:underline' %>
        &middot;
        <%= link_to 'Instance health', super_admin_instance_status_url, class: 'text-xs text-woot-500 hover:underline' %>
      </p>
    </div>

    <div>
      <h2 class="text-base font-semibold mb-1">Product areas</h2>
      <p class="text-xs text-slate-500 mb-2">
        Computed from the product's own records, calculated
        <%= @overview[:computed_at] ? time_ago_in_words(@overview[:computed_at]) + ' ago' : 'just now' %>.
      </p>
      <div class="border border-slate-100 rounded-md px-4">
        <% @overview[:computed].each do |component| %>
          <%= render 'component', component: component %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="mt-8">
    <h2 class="text-base font-semibold mb-1">Recent recorded issues</h2>
    <p class="text-xs text-slate-500 mb-2">
      <%= pluralize(@overview[:signals][:open], 'open issue') %>,
      <%= @overview[:signals][:critical] %> critical,
      <%= @overview[:signals][:unlinked] %> with no support case.
      <%= link_to 'See all', issues_super_admin_operations_path, class: 'text-woot-500 hover:underline' %>
    </p>
    <% if @overview[:signals][:recent].empty? %>
      <p class="text-sm text-slate-500 border border-slate-100 rounded-md p-4">
        Nothing has been recorded. This is not the same as healthy: recording started when this feature was
        deployed, and it reconstructs nothing from before then.
      </p>
    <% else %>
      <%= render 'signals', signals: @overview[:signals][:recent], show_actions: false %>
    <% end %>
  </div>
</section>
