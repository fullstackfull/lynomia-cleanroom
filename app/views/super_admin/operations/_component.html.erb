<%#
  One health component. `source_class` is shown on every row, because how a fact was established is what lets a
  reader judge it: `probed` was read live, `recorded` is a durable row, `computed` is derived from the product's
  own records, and `absent` means nothing records this at all.
%>
<div class="flex items-start justify-between gap-4 border-b border-slate-100 py-2 last:border-b-0">
  <div class="min-w-0">
    <p class="text-sm text-slate-800"><%= component.key.to_s.humanize %></p>
    <% if component.reason.present? %>
      <p class="text-xs text-slate-600 mt-0.5"><%= component.reason %></p>
    <% end %>
    <% if component.detail.present? %>
      <p class="text-xs text-slate-400 mt-0.5 font-mono break-all">
        <%= component.detail.map { |key, value| "#{key}=#{value}" }.join(' ') %>
      </p>
    <% end %>
  </div>
  <div class="flex items-center gap-2 flex-shrink-0">
    <span class="text-xs text-slate-400"><%= component.source_class %></span>
    <%= render 'status_badge', status: component.status %>
    <% if component.investigate.present? %>
      <%= link_to 'Investigate', component.investigate, class: 'text-xs text-woot-500 hover:underline' %>
    <% end %>
  </div>
</div>
