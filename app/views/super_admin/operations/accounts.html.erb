<% content_for(:title) do %>Operations accounts<% end %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title">Operations</h1>
</header>

<section class="main-content__body">
  <%= render 'tabs' %>

  <p class="text-sm text-slate-600 mb-4">
    Per-account component statuses. There is no health score: a single number is something nobody can act on,
    and averaging an <strong>unknown</strong> into one would turn missing information into a reassuring digit.
    Each component stands on its own and the account badge is the worst of them.
  </p>

  <div class="space-y-4">
    <% @health[:rows].each do |row| %>
      <div class="border border-slate-100 rounded-md">
        <div class="flex items-center justify-between px-4 py-3 bg-slate-25 border-b border-slate-100">
          <div>
            <%= link_to row[:account].name, super_admin_account_path(row[:account]),
                        class: 'text-sm text-woot-500 hover:underline' %>
            <span class="text-xs text-slate-500 ms-2">ID <%= row[:account].id %></span>
          </div>
          <%= render 'status_badge', status: row[:status] %>
        </div>
        <div class="px-4">
          <% row[:components].sort_by(&:rank).each do |component| %>
            <%= render 'component', component: component %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-4 text-xs text-slate-500">
    Page <%= @health[:accounts].current_page %> of <%= @health[:accounts].total_pages %> &middot;
    <%= pluralize(@health[:accounts].total_count, 'account') %>
    <%= paginate @health[:accounts], theme: 'administrate' rescue nil %>
  </div>
</section>
